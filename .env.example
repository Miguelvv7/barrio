# Copy to .env.local for local development. Everything is optional locally:
# with no Supabase vars the app runs on an in-memory store seeded with the demo businesses.

# --- Database (required in production: serverless instances don't share memory) ---
# Create the Supabase project in us-east-1 (N. Virginia): Alexa+ calls from the US and the MCP
# functions run in Vercel's iad1 (vercel.json) — the same region keeps round trips fast.
SUPABASE_URL=
# Settings → API → service_role key. Server-only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard access ---
# Required in production: without it nobody can edit (visitors always get a read-only view).
BARRIO_ADMIN_PASSWORD=
# Signs cookies, calendar links and tokens. Any long random string: `openssl rand -hex 32`.
BARRIO_SECRET=

# --- AI features (Anthropic) ---
# Powers the Alexa+ voice simulator (/try/<business>) and "Snap your menu" imports.
# Set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-haiku-5-5 (simulator), claude-sonnet-5-5 (menu photos).
ASSISTANT_MODEL=
IMPORT_MODEL=

# --- Emails (optional, via Resend) ---
# Customer confirmations (when they give an email) and owner "new booking" alerts.
RESEND_API_KEY=
# e.g. "Barrio <reservas@yourdomain.com>" — the domain must be verified in Resend.
BARRIO_EMAIL_FROM=

# --- Data retention (Vercel Cron → /api/cron/retention, daily) ---
# Bookings are deleted 12 months after the appointment. Vercel sends this as a Bearer token.
CRON_SECRET=

# --- OAuth 2.1 for the MCP endpoint (optional; for an Alexa+ private-server add-on) ---
# With a client configured, tokens are verified when sent; set BARRIO_MCP_AUTH=required to
# reject anonymous requests (bare 401, no WWW-Authenticate — as Alexa+ expects).
BARRIO_OAUTH_CLIENT_ID=
BARRIO_OAUTH_CLIENT_SECRET=
BARRIO_MCP_AUTH=
# Optional separate key for signing access tokens (defaults to BARRIO_SECRET).
BARRIO_OAUTH_SIGNING_SECRET=

# --- Public pages ---
# Public URL used in emails, calendar links and the dashboard (otherwise taken from the request).
BARRIO_PUBLIC_URL=
# Contact shown on /privacy and /terms (otherwise a link to the repository).
BARRIO_CONTACT_EMAIL=
BARRIO_REPO_URL=
# Shows "Demo: bookings made here are not sent to the real business" on /try pages.
# Set to "off" only once a business really uses Barrio for its bookings.
BARRIO_DEMO_NOTICE=
# Extra browser origins allowed to call the MCP endpoint, comma-separated (e.g. a hosted MCP
# Inspector). Server-to-server clients like Alexa+ send no Origin and need nothing here.
BARRIO_ALLOWED_ORIGINS=

# --- Escape hatch ---
# On Vercel production the app refuses to start without Supabase (in-memory bookings would differ
# per instance). Set to 1 only for a throwaway demo deployment that accepts losing bookings.
BARRIO_ALLOW_MEMORY_STORE=
