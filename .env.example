# Copy to .env.local for local development. Everything is optional locally:
# with no Supabase vars the app runs on an in-memory store seeded with the demo businesses.

# --- Database (required in production: serverless instances don't share memory) ---
SUPABASE_URL=
# Settings → API → service_role key. Server-only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard access ---
# When set, the dashboard is read-only for visitors; the owner logs in at /login.
BARRIO_ADMIN_PASSWORD=
# Signs session cookies. Any long random string (e.g. `openssl rand -hex 32`).
BARRIO_SECRET=

# --- Alexa+ voice simulator (/try/<business>) ---
ANTHROPIC_API_KEY=
# Optional override. Default: claude-haiku-5-5
ASSISTANT_MODEL=

# --- Optional ---
# Public URL shown in the dashboard (otherwise taken from the request host).
BARRIO_PUBLIC_URL=
# Extra browser origins allowed to call the MCP endpoint, comma-separated
# (e.g. a hosted MCP Inspector). Server-to-server clients need nothing here.
BARRIO_ALLOWED_ORIGINS=
# Shows "Demo: bookings made here are not sent to the real business" on /try pages.
# Set to "off" only once a business really uses Barrio for its bookings.
BARRIO_DEMO_NOTICE=
